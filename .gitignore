# --- Sensitive or local-only files ---
.gcp/
.env
.env.*
*.env
*.key
*.pem
*.p12
*token*.json
*secret*.json
*service-account*.json
kaggle.json
docs2/

# --- Data files ---
data/
*.parquet
*.tsv
*.xls
*.xlsx
*.db
*.sqlite
*.sqlite3
*.duckdb
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.feather
*.rds
*.sas7bdat

# Ignore CSV by default
*.csv

# Allow validation artifacts
!python/outputs/*.csv

# --- Jupyter ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/
00*.ipynb
**/*.quarto_ipynb

# --- Local system files ---
.DS_Store
._*

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# --- Virtual environments ---
.venv/
venv/
.uv-cache/

# --- VS Code ---
.vscode/

# --- SAS ---
sas/logs/
sas/data/
sas/outputs/*.html
sas/outputs/*.rtf
*.log
*.lst
*.sas7bcat

# Sensitive/local SAS inputs
sas/inputs/*.csv

# Optional:
# Ignore PDFs by default
*.pdf

# If you later want to track selected PDFs:
# !sas/outputs/*.pdf

/.quarto/
**/.quarto/
_site/
**/_site/
outputs/

